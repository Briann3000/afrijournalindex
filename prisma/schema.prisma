// Prisma Database Schema for AfriJournal Index (MySQL Native)
// Optimized for cPanel and production MySQL deployments

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  RESEARCHER
  PUBLISHER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique @db.VarChar(191)
  passwordHash  String      @db.VarChar(255)
  name          String      @db.VarChar(255)
  role          Role        @default(RESEARCHER)
  orcid         String?     @unique @db.VarChar(191)
  institution   String?     @db.VarChar(255)
  department    String?     @db.VarChar(255)
  bio           String?     @db.Text
  totalCitations Int        @default(0)
  hIndex        Int         @default(0)
  i10Index      Int         @default(0)
  citations5Yr  Int         @default(0)
  hIndex5Yr     Int         @default(0)
  i10Index5Yr   Int         @default(0)
  googleScholarId String?   @db.VarChar(100)
  googleScholarUrl String?  @db.Text
  openAlexId    String?     @db.VarChar(100)
  isClaimed     Boolean     @default(false)
  claimToken    String?     @db.VarChar(255)
  claimTokenExpiry DateTime?
  metricsSource String?     @default("OPENALEX") @db.VarChar(50)
  lastMetricsSyncAt DateTime?
  cvPdfUrl      String?     @db.Text
  dossierData   String?     @db.LongText
  resetToken    String?     @db.VarChar(255)
  resetTokenExpiry DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  institutionId String?
  institutionRelation Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  journals      Journal[]
  submissions   Submission[]
  comments      Comment[]
  claims        ClaimedPublication[]
  payments      Payment[]
  forumTopics   ForumTopic[]
  forumReplies  ForumReply[]
  posts         Post[]
  postComments  PostComment[]
  postLikes     PostLike[]

  @@index([institutionId])
  @@index([totalCitations])
  @@index([hIndex])
  @@map("user")
}

model Institution {
  id                     String    @id @default(uuid())
  name                   String    @unique @db.VarChar(500)
  country                String    @db.VarChar(100)
  countryCode            String?   @db.VarChar(10)
  openAlexId             String?   @unique @db.VarChar(100)
  rorId                  String?   @unique @db.VarChar(100)
  domain                 String?   @db.VarChar(255)
  websiteUrl             String?   @db.Text
  totalPublications      Int       @default(0)
  totalCitations         Int       @default(0)
  institutionalHIndex    Int       @default(0)
  twoYearMeanCitedness   Float     @default(0.0)
  topDiscipline          String?   @default("Multidisciplinary") @db.VarChar(100)
  isClaimed              Boolean   @default(false)
  claimedByUserId        String?   @db.VarChar(191)
  lastMetricsSyncAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  facultyMembers         User[]

  @@index([country])
  @@index([name])
  @@map("institution")
}

model Journal {
  id            String            @id @default(uuid())
  name          String            @db.VarChar(500)
  issn          String?           @unique @db.VarChar(50)
  eissn         String?           @unique @db.VarChar(50)
  description   String?           @db.Text
  publisherName String            @db.VarChar(500)
  country       String            @db.VarChar(100)
  frequency     String            @default("Quarterly") @db.VarChar(100)
  websiteUrl    String?           @db.Text
  indexedAt     DateTime?
  qualityGrade  String?           @db.VarChar(10) // e.g. "A+", "A", "B", "C"
  isIndexed     Boolean           @default(false)
  certificatePaid Boolean         @default(false)
  isScopusIndexed Boolean         @default(false)
  isWosIndexed    Boolean         @default(false)
  activeTier    String            @default("FREE") @db.VarChar(50) // FREE, BASIC, PREMIUM
  subscriptionExpiresAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  // Relations
  publisherId   String?
  publisher     User?             @relation(fields: [publisherId], references: [id])
  submissions   Submission[]
  articles      Article[]
  reports       ImpactFactorReport[]
  comments      Comment[]
  payments      Payment[]

  @@index([country])
  @@index([name])
  @@index([isIndexed])
  @@index([certificatePaid])
  @@index([isScopusIndexed])
  @@index([isWosIndexed])
  @@map("journal")
}

model Submission {
  id            String            @id @default(uuid())
  journalName   String            @db.VarChar(500)
  issn          String?           @db.VarChar(50)
  eissn         String?           @db.VarChar(50)
  description   String            @db.Text
  publisherName String            @db.VarChar(500)
  country       String            @db.VarChar(100)
  frequency     String            @db.VarChar(100)
  websiteUrl    String            @db.Text
  pdfFileUrl    String?           @db.Text
  status        SubmissionStatus  @default(PENDING)
  evaluationLog String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  submitterId   String
  submitter     User              @relation(fields: [submitterId], references: [id])
  journalId     String?
  journal       Journal?          @relation(fields: [journalId], references: [id])

  @@map("submission")
}

model Article {
  id            String      @id @default(uuid())
  title         String      @db.Text
  doi           String?     @unique @db.VarChar(255)
  abstract      String?     @db.LongText
  url           String?     @db.Text
  pdfUrl        String?     @db.Text
  publishDate   DateTime
  citationCount Int         @default(0)
  createdAt     DateTime    @default(now())
  
  journalId     String
  journal       Journal     @relation(fields: [journalId], references: [id], onDelete: Cascade)
  
  citations     Citation[]  @relation("ArticleCitations")
  citedBy       Citation[]  @relation("ArticleCitedBy")
  claims        ClaimedPublication[]

  @@index([journalId])
  @@index([publishDate])
  @@map("article")
}

model Citation {
  id              String   @id @default(uuid())
  citedAt         DateTime @default(now())
  citingVenue     String?  @db.VarChar(500)
  citingCountry   String?  @db.VarChar(100)
  
  citingArticleId String
  citingArticle   Article  @relation("ArticleCitations", fields: [citingArticleId], references: [id], onDelete: Cascade)
  
  citedArticleId  String
  citedArticle    Article  @relation("ArticleCitedBy", fields: [citedArticleId], references: [id], onDelete: Cascade)

  @@unique([citingArticleId, citedArticleId])
  @@index([citedArticleId])
  @@map("citation")
}

model ImpactFactorReport {
  id                String   @id @default(uuid())
  year              Int
  standardScore     Float
  regionalScore     Float?
  citationCount     Int
  articleCount      Int
  quartile          String?  @db.VarChar(10) // e.g. "Q1", "Q2", "Q3", "Q4", "Unrated"
  disciplineRank    Int?
  totalInDiscipline Int?
  primaryDiscipline String?  @db.VarChar(100)
  pdfReportUrl      String?  @db.Text
  createdAt         DateTime @default(now())

  journalId         String
  journal           Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, year])
  @@index([year])
  @@index([quartile])
  @@map("impactfactorreport")
}

model Comment {
  id          String   @id @default(uuid())
  content     String   @db.Text
  createdAt   DateTime @default(now())
  
  journalId   String
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comment")
}

model ClaimedPublication {
  id          String   @id @default(uuid())
  userId      String
  articleId   String
  role        String   @default("Lead Author") @db.VarChar(100)
  status      String   @default("VERIFIED") @db.VarChar(50) // VERIFIED or PENDING_AUDIT
  claimedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@map("claimedpublication")
}

model Payment {
  id            String   @id @default(uuid())
  trackingId    String   @unique @db.VarChar(191)
  journalId     String
  userId        String?
  amount        Float
  currency      String   @default("KES") @db.VarChar(10)
  tier          String   @default("BASIC") @db.VarChar(50) // BASIC or PREMIUM
  status        String   @default("COMPLETE") @db.VarChar(50)
  customerEmail String?  @db.VarChar(191)
  rawResponse   String?  @db.Text
  createdAt     DateTime @default(now())

  journal       Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([journalId])
  @@index([userId])
  @@index([trackingId])
  @@index([createdAt])
  @@map("payment")
}

// -------------------------------------------------------------
// AfriScholarChat: Scholarly Discourse & Editorial Forum
// -------------------------------------------------------------

model ForumCategory {
  id          String       @id @default(uuid())
  slug        String       @unique @db.VarChar(100)
  name        String       @db.VarChar(255)
  description String       @db.Text
  icon        String       @default("fa-comments") @db.VarChar(50)
  displayOrder Int         @default(0)
  topics      ForumTopic[]
  createdAt   DateTime     @default(now())

  @@map("forum_category")
}

model ForumTopic {
  id          String        @id @default(uuid())
  title       String        @db.VarChar(500)
  slug        String        @unique @db.VarChar(550)
  content     String        @db.Text
  isPinned    Boolean       @default(false)
  isLocked    Boolean       @default(false)
  viewsCount  Int           @default(0)
  
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies     ForumReply[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
  @@map("forum_topic")
}

model ForumReply {
  id          String     @id @default(uuid())
  content     String     @db.Text
  
  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([topicId])
  @@index([authorId])
  @@index([createdAt])
  @@map("forum_reply")
}

// -------------------------------------------------------------
// AfriJournalPost: Scholarly Publications, Preprints & Research Updates
// -------------------------------------------------------------

model Post {
  id              String        @id @default(uuid())
  authorId        String
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postType        String        @default("UPDATE") @db.VarChar(50) // "PAPER", "UPDATE", "CONFERENCE", "PREPRINT"
  title           String?       @db.VarChar(500)
  content         String        @db.Text
  attachmentUrl   String?       @db.Text
  attachmentName  String?       @db.VarChar(255)
  attachmentType  String?       @default("PDF") @db.VarChar(50)
  tags            String?       @db.VarChar(500)
  likesCount      Int           @default(0)
  commentsCount   Int           @default(0)
  sharesCount     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  comments        PostComment[]
  likes           PostLike[]

  @@index([authorId])
  @@index([postType])
  @@index([createdAt])
  @@map("post")
}

model PostComment {
  id          String    @id @default(uuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([postId])
  @@index([authorId])
  @@map("post_comment")
}

model PostLike {
  id          String    @id @default(uuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_like")
}



