// Prisma Database Schema for AfriJournal Index (MySQL Native)
// Optimized for cPanel and production MySQL deployments

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  RESEARCHER
  PUBLISHER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique @db.VarChar(191)
  passwordHash  String      @db.VarChar(255)
  name          String      @db.VarChar(255)
  role          Role        @default(RESEARCHER)
  orcid         String?     @unique @db.VarChar(191)
  institution   String?     @db.VarChar(255)
  bio           String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  journals      Journal[]
  submissions   Submission[]
  comments      Comment[]
  claims        ClaimedPublication[]
  payments      Payment[]
}

model Journal {
  id            String            @id @default(uuid())
  name          String            @db.VarChar(500)
  issn          String?           @unique @db.VarChar(50)
  eissn         String?           @unique @db.VarChar(50)
  description   String?           @db.Text
  publisherName String            @db.VarChar(500)
  country       String            @db.VarChar(100)
  frequency     String            @default("Quarterly") @db.VarChar(100)
  websiteUrl    String?           @db.Text
  indexedAt     DateTime?
  qualityGrade  String?           @db.VarChar(10) // e.g. "A+", "A", "B", "C"
  isIndexed     Boolean           @default(false)
  certificatePaid Boolean         @default(false)
  activeTier    String            @default("FREE") @db.VarChar(50) // FREE, BASIC, PREMIUM
  subscriptionExpiresAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  // Relations
  publisherId   String?
  publisher     User?             @relation(fields: [publisherId], references: [id])
  submissions   Submission[]
  articles      Article[]
  reports       ImpactFactorReport[]
  comments      Comment[]
  payments      Payment[]

  @@index([country])
  @@index([name])
  @@index([isIndexed])
  @@index([certificatePaid])
}

model Submission {
  id            String            @id @default(uuid())
  journalName   String            @db.VarChar(500)
  issn          String?           @db.VarChar(50)
  eissn         String?           @db.VarChar(50)
  description   String            @db.Text
  publisherName String            @db.VarChar(500)
  country       String            @db.VarChar(100)
  frequency     String            @db.VarChar(100)
  websiteUrl    String            @db.Text
  pdfFileUrl    String?           @db.Text
  status        SubmissionStatus  @default(PENDING)
  evaluationLog String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  submitterId   String
  submitter     User              @relation(fields: [submitterId], references: [id])
  journalId     String?
  journal       Journal?          @relation(fields: [journalId], references: [id])
}

model Article {
  id            String      @id @default(uuid())
  title         String      @db.Text
  doi           String?     @unique @db.VarChar(255)
  abstract      String?     @db.LongText
  pdfUrl        String?     @db.Text
  publishDate   DateTime
  createdAt     DateTime    @default(now())
  
  journalId     String
  journal       Journal     @relation(fields: [journalId], references: [id], onDelete: Cascade)
  
  citations     Citation[]  @relation("ArticleCitations")
  citedBy       Citation[]  @relation("ArticleCitedBy")
  claims        ClaimedPublication[]

  @@index([journalId])
  @@index([publishDate])
}

model Citation {
  id              String   @id @default(uuid())
  citedAt         DateTime @default(now())
  
  citingArticleId String
  citingArticle   Article  @relation("ArticleCitations", fields: [citingArticleId], references: [id], onDelete: Cascade)
  
  citedArticleId  String
  citedArticle    Article  @relation("ArticleCitedBy", fields: [citedArticleId], references: [id], onDelete: Cascade)

  @@unique([citingArticleId, citedArticleId])
  @@index([citedArticleId])
}

model ImpactFactorReport {
  id                String   @id @default(uuid())
  year              Int
  standardScore     Float
  regionalScore     Float?
  citationCount     Int
  articleCount      Int
  quartile          String?  @db.VarChar(10) // e.g. "Q1", "Q2", "Q3", "Q4", "Unrated"
  disciplineRank    Int?
  totalInDiscipline Int?
  primaryDiscipline String?  @db.VarChar(100)
  pdfReportUrl      String?  @db.Text
  createdAt         DateTime @default(now())

  journalId         String
  journal           Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, year])
  @@index([year])
  @@index([quartile])
}

model Comment {
  id          String   @id @default(uuid())
  content     String   @db.Text
  createdAt   DateTime @default(now())
  
  journalId   String
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ClaimedPublication {
  id          String   @id @default(uuid())
  userId      String
  articleId   String
  role        String   @default("Lead Author") @db.VarChar(100)
  status      String   @default("VERIFIED") @db.VarChar(50) // VERIFIED or PENDING_AUDIT
  claimedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

model Payment {
  id            String   @id @default(uuid())
  trackingId    String   @unique @db.VarChar(191)
  journalId     String
  userId        String?
  amount        Float
  currency      String   @default("KES") @db.VarChar(10)
  tier          String   @default("BASIC") @db.VarChar(50) // BASIC or PREMIUM
  status        String   @default("COMPLETE") @db.VarChar(50)
  customerEmail String?  @db.VarChar(191)
  rawResponse   String?  @db.Text
  createdAt     DateTime @default(now())

  journal       Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([journalId])
  @@index([userId])
  @@index([trackingId])
  @@index([createdAt])
}

