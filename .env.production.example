# AfriJournal Index - Production Environment Configuration Template
# Copy this file to .env.production or enter these variables into your cPanel Node.js Application Manager

# ==========================================
# 1. NODE ENVIRONMENT
# ==========================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ==========================================
# 2. APPLICATION SECRETS & BASE URL
# ==========================================
# Generate a strong 32+ character random string for production HMAC signature and session encryption
NEXTAUTH_SECRET=change-this-to-a-secure-random-32-char-secret-key
SESSION_SECRET=change-this-to-a-secure-random-32-char-secret-key
NEXTAUTH_URL=https://afrijournalindex.org
NEXT_PUBLIC_APP_URL=https://afrijournalindex.org

# ==========================================
# 3. CPANEL MARIADB / MYSQL DATABASE CONNECTION
# ==========================================
# Option A: Full Connection String URL
DATABASE_URL="mysql://cpaneluser_dbuser:StrongPasswordHere@localhost:3306/cpaneluser_afrijournal"

# Option B: Discrete Parameters (Optional fallback)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=StrongPasswordHere
DB_DATABASE=cpaneluser_afrijournal
DB_POOL_LIMIT=10

# ==========================================
# 4. PAYMENT GATEWAY (INTASEND / M-PESA)
# ==========================================
INTASEND_PUB_KEY=ISPubKey_live_xxxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_live_xxxxxxxxx
INTASEND_TEST_MODE=false

# ==========================================
# 5. PUBLIC INDEXING & HARVESTING (OPTIONAL)
# ==========================================
CRON_SECRET_KEY=generate-a-secret-key-for-scheduled-crons
